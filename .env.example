# ==============================================================================
# CẤU HÌNH NODE ZLMEDIKIT ĐỘC LẬP & TỰ ĐỘNG GIA NHẬP CỤM (CLUSTER JOIN TOKEN)
# ==============================================================================
# LƯU Ý BẢO MẬT: File này KHÔNG CHỨA bất kỳ tài khoản hay mật khẩu quản trị nào!

# 1. THÔNG TIN KẾT NỐI VỀ WVP MASTER (CONTROL PLANE)
WVP_MASTER_HOST=192.168.1.100
WVP_MASTER_PORT=18978

# Mã Token gia nhập cụm (Phải khớp với "media.secret" trên WVP Master)
CLUSTER_JOIN_TOKEN=wvp_cluster_join_secret_key_2026

# 2. ĐỊNH DANH VÀ SECRET RIÊNG CỦA NODE NÀY (BẢO MẬT CHIA VÙNG)
# Ví dụ: zlm_north_01 (Miền Bắc), zlm_south_01 (Miền Nam)...
NODE_ID=zlm_node_01

# Secret độc lập của riêng Node này (Dùng khi xem stream, bảo mật phân vùng)
NODE_SECRET=secret_node_01_random_secure_key

# 3. ĐỊA CHỈ MẠNG CỦA MÁY CHỦ NÀY
# IP nội bộ để WVP Master kết nối tới
NODE_IP=192.168.1.101

# IP để Camera an ninh nhìn thấy và bắn luồng RTP vào (Public IP hoặc WAN IP)
NODE_SDP_IP=27.71.24.106

# IP để Client Web/App kết nối vào xem luồng Video (Public IP hoặc WAN IP)
NODE_STREAM_IP=27.71.24.106

# 4. CÁC CỔNG DỊCH VỤ CỦA ZLMEDIKIT
ZLM_HTTP_PORT=80
ZLM_RTSP_PORT=554
ZLM_RTMP_PORT=1935
ZLM_RTP_PORT=10000
ZLM_RTP_PORT_RANGE=30000,30500
