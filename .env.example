# =================================================================
#               CẤU HÌNH NODE ZLMEDIAKIT (STANDALONE)
# =================================================================

# 1. Tên định danh duy nhất cho Node này (bắt buộc phân biệt giữa các node)
MEDIA_SERVER_ID=zlm_node_02

# 2. Khóa bí mật API REST (Phải khớp với WVP Master khi Add Node)
SECRET=su6TiedN2rVAmBbIDX0aa0QTiBJLBdcf

# 3. Địa chỉ IP và Cổng của Server WVP Master (để Node này gửi Webhook về WVP)
WVP_HOST=192.168.100.1
WVP_PORT=18978

# 4. Các cổng mạng của Node ZLMediaKit này (khi expose qua Bridge hoặc Host network)
HTTP_PORT=80
HTTP_SSL_PORT=0
RTSP_PORT=554
RTMP_PORT=1935
RTP_PORT=10000
RTC_PORT=8000
SRT_PORT=9000
RTP_PORT_RANGE=30000-30500

# 5. Đường dẫn thư mục lưu trữ video ghi hình trên máy chủ này
VIDEO_STORAGE_PATH=/data/video
LOG_STORAGE_PATH=/data/logs
